# §13 of kusoma-migration-prompt.md. Copy to .env and fill in.

# Local Docker:
DATABASE_URL=postgres://kusoma:kusoma@localhost:55432/kusoma
# Managed/cloud Postgres (Neon, Supabase, RDS, Cloud SQL) — keep ?sslmode=require;
# that is what switches the pool into TLS. Nothing else changes.
# DATABASE_URL=postgres://user:pass@host:5432/kusoma?sslmode=require
#
# Optional. Without it the TLS chain is encrypted but NOT verified, which is
# what most providers' copy-paste URLs need. Set it in production if your
# provider publishes a root certificate.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

JWT_SECRET=change-me-in-any-real-deployment
PORT=3000

# Telegram (§7). Unset is fine — the server boots and skips setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BACKEND_URL=

# CBC Curriculum API (§10). Unset is fine — curriculum browsing errors and the
# AI proceeds without grounding, exactly as specced. No fake fallback data.
# Auth against the live API is Authorization: Bearer <CBC_API_KEY>.
CBC_API_URL=
CBC_API_KEY=

# Anthropic API — direct API, not Bedrock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
